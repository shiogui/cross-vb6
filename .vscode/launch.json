{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Watch",
      "type": "dotnet",
      "program": "dotnet",
      "request": "launch",
      "cwd": "${workspaceFolder}/IDE",
      "projectPath": "${workspaceFolder}/IDE/IDE.csproj",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/IDE/IDE.csproj"
      ],
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
      }
    }
  ]
}
